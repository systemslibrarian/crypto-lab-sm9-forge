  "caveats": [
    {
      "id": "h1-cancels-in-verification",
      "severity": "high",
      "claim": "An SM9 sign->verify round trip does NOT establish that H1, the identity encoding, or hid is correct.",
      "why": "Extraction sets t1 = H1(ID||hid) + ks and t2 = ks * t1^-1, so t1*t2 == ks for ANY H1. Verification forms P = [H1]P2 + Ppub-s = [t1]P2 and S = [l*t2]P1, so u = e(S,P) = e(P1,P2)^(l*ks). H1 cancels. A consistently-wrong H1 yields the same u, the same signature component h, and verifies.",
      "established_by": "gate2/h1-cancellation.mjs -- measured, with a 0x03-prefixed H1 variant shown to verify while producing a different ds_A",
      "consequence": "the lab must check the annex-pinned H1 / t1 / t2 / ds_A values, not a round trip; and its displayed verdict must not claim a round trip proves identity binding"
    },
    {
      "id": "fp12-pow-reduces-mod-p",
      "severity": "low",
      "claim": "GmSSL-JS fp12_pow() opens with \"k %= SM9_P\", reducing the exponent modulo the field characteristic p rather than the group order N.",
      "why": "Every legitimate SM9 exponent is already < N < p, so it is a no-op for correct inputs. It would silently accept an out-of-range exponent instead of rejecting it.",
      "established_by": "gate2/gate2cA-crosscheck.mjs leg 4 (N < p, r < N, h < N all checked)",
      "consequence": "the protocol layer must reduce mod N itself and range-check h in [1, N-1]; it must not inherit that from the vendored engine"
    },
    {
      "id": "annex-strips-leading-zeros",
      "severity": "low",
      "claim": "The annex prints ks and r with leading zeros stripped -- 62 nibbles, not 64.",
      "why": "GmSSL C pins the same ks as \"000130E7...\" (64 nibbles). A byte-for-byte string comparison against the annex text fails unless scalars are left-padded or compared as integers.",
      "established_by": "gate2/annexA-parse.mjs, which records rawHex length beside the padded value",
      "consequence": "parse scalars as integers; never length-compare annex scalar text"
    },
    {
      "id": "single-engine-pairing",
      "severity": "medium",
      "claim": "The Fp12 values (g, w, u, w′) are reproduced by ONE engine only.",
      "why": "GmSSL C pinned vectors and a compiled GmSSL-C-over-OpenSSL-SM3 binary independently corroborate ks, ds_A and H1. No second pairing implementation was run, so the pairing agreement is with the STANDARD’s printed values, not between two engines.",
      "established_by": "gate2/gate2cA-crosscheck.mjs leg 5, recorded as unavailable rather than as agreement",
      "consequence": "the lab’s gmssl-node cross-check leg cannot close this either -- its SM9 API cannot import a pinned master key"
    }
  ],
