{
  "name": "crypto-lab-sm9-forge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:typescript && node node_modules/@typescript/native/bin/tsc --noEmit && vite build",
    "check:typescript": "node --test test/tooling.node.mjs",
    "preview": "vite preview",
    "test": "vitest run && node --test test/csp.test.js test/tooling.node.mjs",
    "test:watch": "vitest",
    "test:a11y": "playwright test --project=a11y",
    "test:e2e": "playwright test --project=claims",
    "test:geometry": "playwright test --project=geometry",
    "test:oracle": "vitest run src/sm9/oracle.test.ts"
  },
  "dependencies": {
    "@li0ard/sm3": "^0.1.1",
    "@li0ard/sm4": "^0.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "playwright": "^1.62.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
